{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDir": "./src",
    "outDir": ".",
    "noEmit": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src/**/*.mts"],
  "exclude": ["node_modules"]
}
