{
  "name": "giocaizzi-harness",
  "version": "3.6.1",
  "private": true,
  "packageManager": "npm@11.19.1",
  "description": "pi package: the giocaizzi-harness skills, the guard, a subagent tool for the plugins' agents, and hud's footer and sounds' alerts. Install with `pi install git:github.com/giocaizzi/harness`.",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "build:typescript": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "lint:typescript": "eslint src --ext .mts --max-warnings=0",
    "format": "prettier --write \"src/**/*.mts\" package.json tsconfig.json tsconfig.build.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.mts\" package.json tsconfig.json tsconfig.build.json .prettierrc.json",
    "knip": "knip"
  },
  "pi": {
    "extensions": [
      "./plugins/guard/hooks/pi.mjs",
      "./plugins/dev-tools/pi/subagent.mjs",
      "./plugins/hud/hooks/pi-entry.mjs",
      "./plugins/sounds/hooks/pi.mjs"
    ],
    "skills": [
      "./plugins/*/skills"
    ]
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
