{
  "description": "guard: skill enforcer, title guard, host guard and risky-command ask for Claude Code and Copilot CLI",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Skill|bash|powershell|skill",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" PreToolUse", "timeout": 30 }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" UserPromptSubmit", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" SessionEnd", "timeout": 10 }] }
    ]
  }
}
