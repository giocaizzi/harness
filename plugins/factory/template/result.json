{
  "schema": 1,
  "ticket": "<owner>/<repo>#<number>",
  "end_state": "done",
  "reason": "",
  "pr": "https://github.com/<owner>/<repo>/pull/<number>",
  "decisions": [
    {
      "item": "<what was found>",
      "test": "R2",
      "decision": "folded",
      "where": "<commit sha>"
    }
  ],
  "evidence": [
    "https://github.com/<owner>/<repo>/issues/<number>#issuecomment-<id>"
  ],
  "follow_ups": [
    "https://github.com/<owner>/<repo>/issues/<number>"
  ],
  "cost_usd": null,
  "turns": null,
  "harness": "<claude-code|copilot-cli|vscode|codex|opencode|pi>",
  "model": "<model id as the harness reports it>",
  "effort": "<effort level, or null>",
  "sessions": [
    {
      "role": "main",
      "id": "<harness session id>"
    },
    {
      "role": "verifier",
      "id": "<subagent or session id>"
    }
  ],
  "plugin_versions": {
    "factory": "<version>",
    "dev-tools": "<version>"
  },
  "finished_at": "<ISO 8601 timestamp>"
}
