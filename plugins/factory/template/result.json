{
  "schema": 2,
  "ticket": "<owner>/<repo>#<number>",
  "run_id": "<FACTORY_RUN_ID, else main session id, else <host>-<number>-<UTC timestamp>>",
  "end_state": "done",
  "reason": "",
  "reason_code": null,
  "pr": "https://github.com/<owner>/<repo>/pull/<number>",
  "decisions": [
    { "item": "<what was found>", "test": "R2", "decision": "folded", "where": "<commit sha>" }
  ],
  "evidence": ["<comment, check run or deploy run URL>"],
  "checks": [
    { "command": "<proof or component check>", "result": "pass" }
  ],
  "follow_ups": ["<issue URL>"],
  "posts": [
    { "kind": "result", "url": "<comment URL>", "state": "posted" }
  ],
  "phases": [
    { "name": "plan", "started_at": "<ISO 8601 timestamp>", "ended_at": "<ISO 8601 timestamp>" }
  ],
  "verifier": { "verdict": "pass", "rounds": 1 },
  "routing": [
    { "phase": "verify", "policy_model": "opus", "policy_effort": "medium", "model": "opus", "effort": "medium", "deviation_reason": null }
  ],
  "cost_usd": null,
  "tokens": null,
  "turns": null,
  "harness": "<claude-code|copilot-cli|vscode|codex|opencode|pi>",
  "model": "<model id as the harness reports it>",
  "effort": null,
  "sessions": [
    { "role": "main", "id": "<session id>", "model": "<model id>", "effort": "<level>" },
    { "role": "verifier", "id": "<session id>", "model": "<model id>", "effort": "<level>" }
  ],
  "plugin_versions": { "factory": "<version>", "dev-tools": "<version>" },
  "host": { "name": "<hostname>", "os": "<darwin|linux|windows>", "runner": "attended" },
  "finished_at": "<ISO 8601 timestamp>"
}
